# Copy this file to .env and fill in real values (then `export $(cat .env | xargs)`
# or use a tool like python-dotenv / honcho to load it).

# Long random string used to sign JWTs. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# How long an issued login token stays valid.
JWT_EXP_HOURS=24

# --- Database ---------------------------------------------------------
# Local development (default, zero setup, stores data in appointments.db):
# DATABASE_URL=sqlite:///appointments.db
#
# Cloud/production (managed Postgres from Supabase, Neon, Render, Railway,
# AWS RDS, etc). No code changes needed -- just set this and install
# psycopg2-binary (already in requirements.txt):
# DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Server -------------------------------------------------------------
PORT=5000
FLASK_DEBUG=1

# --- Email ---------------------------------------------------------------
# Leave SMTP_HOST unset and every notification is printed to the server log
# instead of being delivered -- handy for development. Fill it in and the
# same messages go out for real. Examples:
#   SendGrid: smtp.sendgrid.net:587, username "apikey", password <your key>
#   Mailgun:  smtp.mailgun.org:587
#   Gmail:    smtp.gmail.com:587 with an App Password (not your login password)
MAIL_ENABLED=1
MAIL_FROM=Almanac <no-reply@yourdomain.com>
# MAIL_REPLY_TO=support@yourdomain.com
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=your-smtp-password
SMTP_USE_TLS=1          # STARTTLS on port 587 (the usual choice)
SMTP_USE_SSL=0          # set to 1 instead for implicit TLS on port 465
SMTP_TIMEOUT=20

# Used to build the links inside emails.
APP_BASE_URL=http://localhost:5000

# --- Automatic reminders --------------------------------------------------
# A background thread mails both parties once, this many hours before the
# appointment starts. Set REMINDERS_ENABLED=0 if you'd rather drive it from
# cron: POST /api/admin/emails/run-reminders
REMINDERS_ENABLED=1
REMINDER_HOURS_BEFORE=24
REMINDER_SCAN_MINUTES=15
