# Copy this file to .env and fill in real values (then `export $(cat .env | xargs)`
# or use a tool like python-dotenv / honcho to load it).

# Long random string used to sign JWTs. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# How long an issued login token stays valid.
JWT_EXP_HOURS=24

# --- Database ---------------------------------------------------------
# Local development (default, zero setup, stores data in appointments.db):
# DATABASE_URL=sqlite:///appointments.db
#
# Cloud/production (managed Postgres from Supabase, Neon, Render, Railway,
# AWS RDS, etc). No code changes needed -- just set this and install
# psycopg2-binary (already in requirements.txt):
# DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Server -------------------------------------------------------------
PORT=5000
FLASK_DEBUG=1
